# Same Supabase project as the Python backend.
# Use the *anon* key here (not the service role key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# FastAPI base URL.
# - Dev (npm run dev):    leave empty — vite.config.ts proxies /api/* to localhost:8000
# - Prod (Netlify build): set to your Hugging Face Space URL, e.g.
#     VITE_API_BASE=https://YOUR_USER-call-audit.hf.space
VITE_API_BASE=
