# --- Supabase -------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_AUDIO_BUCKET=call-audio

# --- LLM judge ------------------------------------------------------
# "ollama" - CPU-friendly via local Ollama daemon (recommended on laptops)
# "gemma"  - HuggingFace transformers (fine-tunable, needs GPU for 4-bit)
LLM_PROVIDER=ollama

# Ollama path
# Pull first: `ollama pull gemma3:4b`
# For Gemma 4 E4B (best quality, requires Ollama >= 0.x with gemma4 support):
#   ollama pull hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
#   then set OLLAMA_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# HF transformers path (GPU recommended; required for fine-tuning)
GEMMA_MODEL=google/gemma-4-E4B-it
# After fine-tuning, point this at your LoRA adapter folder (or merged dir)
GEMMA_ADAPTER=
GEMMA_LOAD_IN_4BIT=true
GEMMA_MAX_NEW_TOKENS=1024

# --- Transcription (faster-whisper) --------------------------------
# tiny | base | small | medium | large-v3
# Recommended for CPU/16GB-RAM: small (~250MB int8). Auto-promotes to fp16 on CUDA.
WHISPER_MODEL=small
# Empty = auto-detect language. Set e.g. "en" to skip detection and speed up.
WHISPER_LANG=

# --- Embeddings -----------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
